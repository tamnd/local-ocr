# The environment a reader needs on this machine, for systemd and for a shell.
#
# It was in the unit file, which was fine until the first benchmark started a
# server by hand and got "UVA is not available" from a stack that had been
# serving all day under systemd. The environment is not a detail of how the
# process is supervised, so it lives in a file both can read: systemd through
# EnvironmentFile, a script through `set -a; . deploy/reader.env; set +a`.

# WSL puts the driver's user mode libraries here and nowhere a loader would look
# by default. Without this, torch finds no CUDA device and vLLM exits with a
# message about no GPU, on a machine with a 4090 in it.
LD_LIBRARY_PATH=/usr/lib/wsl/lib

HF_HOME=/home/gopher/.cache/huggingface

# vLLM turns pinned host memory off on WSL by default, because for years it was
# not dependable there. Its V2 GPU model runner needs a unified virtual address
# view of a pinned buffer, so with the default the engine dies during startup
# with "UVA is not available" and the machine never serves a page.
#
# The kernel here is 6.18, far past the 4.19.121 that vLLM gates the support on,
# and pinning was checked by hand before this line was written: a pinned tensor
# reports is_pinned, copies to the card, and takes an accelerator view. Turned
# on rather than routed around, because the alternative is the older runner.
VLLM_WSL2_ENABLE_PIN_MEMORY=1

# The weights are already downloaded and pinned by revision. Offline means a hub
# that is slow, rate limiting or simply moved cannot turn a restart into a
# thirty minute wait or, worse, a quiet download of different weights.
HF_HUB_OFFLINE=1
