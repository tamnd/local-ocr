# A reader, named by its entry in models.toml.
#
#   sudo cp deploy/local-ocr-reader@.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now local-ocr-reader@reader-a
#
# Templated, so the bake off in M4 and the two readers of M6 are two more
# instances rather than two more unit files. Which weights an instance loads,
# which port it listens on and which flags it is served under all live in
# models.toml, which is under version control; this file holds only the things
# that are about the machine.

[Unit]
Description=local-ocr reader %i
Documentation=https://github.com/tamnd/local-ocr
After=network-online.target
Wants=network-online.target

# A reader that dies five times in five minutes is not going to come back by
# being restarted a sixth time, and a restart loop on a card this size makes the
# journal useless. Give up and leave the failure visible.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=gopher
Group=gopher
WorkingDirectory=/home/gopher/local-ocr

# The venv is the serving stack: vLLM, torch, and this package installed into it
# with -e. Named in full because a unit file has no PATH worth relying on.
ExecStart=/home/gopher/local-ocr/.venv/bin/local-ocr serve %i \
  --vllm /home/gopher/local-ocr/.venv/bin/vllm

# The driver library path, the hub cache, the WSL pinned memory switch and the
# offline flag, in a file a benchmark script can source as well. They were four
# Environment lines here, and then the first server started by hand outside
# systemd died on startup for want of one of them. The reasons are written next
# to each setting in that file.
EnvironmentFile=/home/gopher/local-ocr/deploy/reader.env

# vLLM shuts down cleanly on SIGINT and is noisy about SIGTERM. Long enough to
# let it finish the page it is on and free the card, short enough that a hung
# server does not hold up a reboot.
KillSignal=SIGINT
TimeoutStopSec=60

# Loading and compiling takes minutes on a cold start. systemd's default would
# call that a failed start and kill it halfway through.
TimeoutStartSec=900

# Covers a reader that dies. Does not cover a reader that stops working without
# dying, which is the failure this project has actually had twice: once a clean
# shutdown, which is not a failure and does not trigger this, and once an engine
# wedged at nought per cent still holding the whole card, which does not exit at
# all. WatchdogSec is the systemd answer to the second one and it needs the
# service to call sd_notify, which vLLM does not. reader-watch.sh in this
# directory is the answer instead: it asks the engine for a token and restarts
# this unit when the engine stops giving one.
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
